rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      // get (by ID) only — no list, so nobody can enumerate every event
      allow get, create: if true;
      allow list, update, delete: if false;
      match /rsvps/{rsvpId} {
        // reachable only via a known event ID
        allow read: if true;
        allow create: if request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 60
                      && request.resource.data.going is bool
                      && (!("count" in request.resource.data)
                          || (request.resource.data.count is int
                              && request.resource.data.count >= 0
                              && request.resource.data.count <= 20));
        allow update, delete: if false;
      }
    }
  }
}
